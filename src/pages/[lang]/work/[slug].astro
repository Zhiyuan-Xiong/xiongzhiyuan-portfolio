---
import Base from '../../../layouts/Base.astro';
import DatingFestival from '../../../components/DatingFestival.astro';
import StigmaCase from '../../../components/StigmaCase.astro';
import MushroomsCase from '../../../components/MushroomsCase.astro';
import NexusCase from '../../../components/NexusCase.astro';
import SkeletonCase from '../../../components/SkeletonCase.astro';
import AlilagunaCase from '../../../components/AlilagunaCase.astro';
import SpeciesCase from '../../../components/SpeciesCase.astro';
import MetamorphosisCase from '../../../components/MetamorphosisCase.astro';
import EarthquakeCase from '../../../components/EarthquakeCase.astro';
import CosmosCase from '../../../components/CosmosCase.astro';
import SonicCase from '../../../components/SonicCase.astro';
import Artwork from '../../../components/Artwork.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { published, type Project } from '../../../data/projects';
import { categories, ui, type Lang } from '../../../data/site';
export function getStaticPaths() { return ['zh','en'].flatMap(lang=>published.map(project=>({params:{lang,slug:project.slug},props:{project}}))); }
const lang=Astro.params.lang as Lang;
const {project:p}=Astro.props as {project:Project};
---
<Base lang={lang} title={p.title[lang]} description={p.description[lang]} active="works" lightCase={p.slug==='bone-series'||p.slug==='post-digital-species'||p.slug==='alilaguna'||p.slug==='infinite-cosmos'||p.slug==='earthquake'} festival={p.slug==='dating-carnival'} restored={p.slug==='stigma'||p.slug==='poisonous-mushrooms'||p.slug==='nexus'||p.slug==='bone-series'||p.slug==='post-digital-species'||p.slug==='alilaguna'||p.slug==='sonic-elasticity'||p.slug==='infinite-cosmos'||p.slug==='earthquake'||p.slug==='metamorphosis'}>
  {p.slug==='dating-carnival' ? <DatingFestival lang={lang}/> : p.slug==='stigma' ? <StigmaCase lang={lang} project={p}/> : p.slug==='poisonous-mushrooms' ? <MushroomsCase lang={lang} project={p}/> : p.slug==='nexus' ? <NexusCase lang={lang} project={p}/> : p.slug==='bone-series' ? <SkeletonCase lang={lang} project={p}/> : p.slug==='post-digital-species' ? <SpeciesCase lang={lang} project={p}/> : p.slug==='alilaguna' ? <AlilagunaCase lang={lang} project={p}/> : p.slug==='metamorphosis' ? <MetamorphosisCase lang={lang} project={p}/> : p.slug==='earthquake' ? <EarthquakeCase lang={lang} project={p}/> : p.slug==='infinite-cosmos' ? <CosmosCase lang={lang} project={p}/> : p.slug==='sonic-elasticity' ? <SonicCase lang={lang} project={p}/> : <div class="container case-page">
    <nav class="breadcrumbs" aria-label={lang==='zh' ? '面包屑导航' : 'Breadcrumbs'}><a href={`/${lang}/`}>{ui.home[lang]}</a><span aria-hidden="true">/</span><a href={`/${lang}/works/`} data-back-link>{ui.works[lang]}</a><span aria-hidden="true">/</span><span aria-current="page">{p.title[lang]}</span></nav>
    <header class="case-header"><p class="eyebrow">{p.kind[lang]}{p.year && ` / ${p.year}`}</p><h1>{p.title[lang]}</h1><p class="case-subtitle">{p.subtitle[lang]}</p><div class="case-tags">{p.categories.map(cat=><a href={`/${lang}/works/?category=${cat}`}>{categories.find(x=>x.id===cat)!.label[lang]}</a>)}</div></header>
    <div class="case-cover"><Artwork image={p.cover!} alt={p.coverAlt![lang]} lang={lang} eager zoom /></div>
    <section class="overview" id="overview" aria-labelledby="overview-title"><div><p class="eyebrow">OVERVIEW</p><h2 id="overview-title">{ui.overview[lang]}</h2><p>{p.overview![lang]}</p>{p.video && <a class="button primary" href={p.video} target="_blank" rel="noopener noreferrer">{lang==='zh' ? '在哔哩哔哩观看完整 MV' : 'Watch the full MV on Bilibili'}<span class="sr-only">{lang==='zh' ? '（新窗口）' : ' (new tab)'}</span></a>}</div><dl class="project-facts"><div><dt>{ui.role[lang]}</dt><dd>{p.role![lang]}</dd></div><div><dt>{ui.stage[lang]}</dt><dd>{p.stage![lang]}</dd></div><div><dt>{ui.deliverables[lang]}</dt><dd>{p.deliverables![lang]}</dd></div></dl></section>
    <div class="case-content"><aside class="case-toc"><details open><summary>{ui.contents[lang]}</summary><nav aria-label={ui.contents[lang]}><a href="#overview">{ui.overview[lang]}</a>{p.sections!.map(s=><a href={`#${s.id}`}>{s.title[lang]}</a>)}</nav></details></aside>
      <div class="case-sections">{p.sections!.map(section=><section class="case-section" id={section.id} aria-labelledby={`title-${section.id}`}><h2 id={`title-${section.id}`}>{section.title[lang]}</h2>{section.paragraphs?.map(text=><p>{text[lang]}</p>)}{section.points && <div class="decision-list">{section.points.map(point=><div><h3>{point.title[lang]}</h3><p>{point.text[lang]}</p></div>)}</div>}{section.figures?.map(f=><Artwork image={f.image} alt={f.alt[lang]} caption={f.caption[lang]} lang={lang} portrait={f.portrait} zoom />)}</section>)}</div>
    </div>
    <section class="related-section" aria-labelledby="related-title"><div class="section-heading"><h2 id="related-title">{ui.related[lang]}</h2><a class="text-link" href={`/${lang}/works/`} data-back-link>{ui.back[lang]}</a></div><div class="project-grid">{published.filter(x=>x.slug!==p.slug).slice(0,2).map(project=><ProjectCard project={project} lang={lang} />)}</div></section>
  </div>}
</Base>
