---
import { festival, scenes } from '../data/dating-festival';
import type { Lang } from '../data/site';
import FestivalFigure from './FestivalFigure.astro';
import FestivalMap from './FestivalMap.astro';
import FestivalMechanismDiagram from './FestivalMechanismDiagram.astro';
import '../styles/dating-festival.css';
const {lang}=Astro.props as {lang:Lang};
const t=(zh:string,en:string)=>lang==='zh'?zh:en;
---
<article class="dating-festival" data-festival-case>
  <section class="festival-hero" aria-label={t('相亲营销嘉年华动态主图','Blind Dating Market Festival motion cover')}>
    <video data-festival-hero autoplay loop muted playsinline preload="auto" poster="/media/dating/hero-poster.webp" aria-label={t('嘉年华中央机械装置，循环影像','Looping film of the central carnival machine')}><source src="/media/dating/hero.mp4" type="video/mp4" /></video>
  </section>
  <div class="festival-case-content">
  <div class="festival-body">
    <nav class="festival-breadcrumbs" aria-label={t('项目位置','Breadcrumbs')}><a href={'/'+lang+'/works/'} data-back-link>{t('作品索引','WORK INDEX')}</a><span>/</span><span aria-current="page">{festival.title[lang]}</span></nav>
    <header class="festival-heading" id="overview">
      <div><p class="festival-kicker">2024 / CONCEPT EXPERIMENT</p><h1>{festival.title[lang]}</h1>{lang==='zh'&&<p class="festival-english-title">Blind Dating Market Festival</p>}<p class="festival-lens">{festival.lens[lang]}</p></div>
      <div class="festival-introduction"><p>{festival.overview[lang]}</p><dl class="festival-facts"><div><dt>{t('类型','TYPE')}</dt><dd>{t('交互叙事 · 三维空间 · 概念影像','Interactive narrative · 3D spaces · Concept film')}</dd></div><div><dt>{t('阶段','STAGE')}</dt><dd>{t('概念设计与影像呈现','Concept design and visualisation')}</dd></div></dl></div>
    </header>
    <div class="festival-reading">
      <aside class="festival-toc case-toc"><details open><summary>{t('项目目录','CONTENTS')}</summary><nav aria-label={t('项目章节','Project chapters')}><a href="#overview">{t('项目概述','Overview')}</a><a href="#research">{t('研究背景','Background')}</a><a href="#mechanisms">{t('设计推演','Development')}</a><a href="#mechanism-diagram">{t('环形机制图','Mechanism diagram')}</a><a href="#experience">{t('场景总览','The six spaces')}</a>{scenes.map(s=><a href={'#'+s.id}><span>{String(s.number).padStart(2,'0')}</span>{s.title[lang]}</a>)}<a href="#concept-film">{t('概念影片','Concept film')}</a></nav></details></aside>
      <div class="festival-chapters">
        <section id="research" class="festival-chapter case-section">
          <div class="festival-section-title"><span>01 / BACKGROUND</span><h2>{t('当代婚恋选择机制与关系认知','Matchmaking, information and judgement')}</h2></div>
          <blockquote class="festival-question">{festival.question[lang]}</blockquote>
          <div class="festival-analysis-visual"><FestivalFigure image="research-early-1" alt={t('研究图：婚恋背景、择偶条件标准化与相亲渠道','Research diagram: the marriage context, standardised partner criteria and matchmaking channels')} caption={t('研究图：婚恋背景、择偶条件与相亲渠道。','Research diagram: the marriage context, partner criteria and matchmaking channels.')} lang={lang}/></div>
          <div class="festival-observations">{festival.background.map((p,i)=><div><span class="festival-small-index">0{i+1}</span><h3>{p.title[lang]}</h3><p>{p.text[lang]}</p></div>)}</div>
          <h3 class="festival-subheading">{t('相亲话术的包装机制','The language of persona packaging')}</h3>
          <div class="festival-analysis-visual"><FestivalFigure image="research-early-2" alt={t('研究图：个人信息展示、相亲话术与身份包装','Research diagram: self-presentation, matchmaking language and persona packaging')} caption={t('研究图：个人信息展示、相亲话术与身份包装。','Research diagram: self-presentation, matchmaking language and persona packaging.')} lang={lang}/></div>
          <div class="festival-packaging">{festival.packaging.map(([label,text])=><div><span>{label[lang]}</span><p>“{text[lang]}”</p></div>)}</div>
          
        </section>
        <section id="mechanisms" class="festival-chapter case-section">
          <div class="festival-section-title"><span>02 / DEVELOPMENT</span><h2>{t('把相亲营销转译为游戏机制','Translate matchmaking into game mechanisms')}</h2></div>
          <div class="festival-development-layout"><div class="festival-development-copy">
          <p>{t('现实中的信息展示、包装与判断，被转译为一条连续的体验路径。参与者先展示自己、建立档案，再经历匹配、互动验证与外部评价，最终形成关系结果。不同选择能够反馈到下一轮匹配，让关系判断成为循环，而不是单次结果。','Real-world presentation, packaging and judgement become a continuous experience. Participants introduce themselves, build profiles, undergo matching, verify information and encounter outside evaluation before reaching a relationship outcome. Choices can feed back into the next matching cycle.')}</p>
          <ol class="festival-path">{scenes.map(s=><li><a href={'#'+s.id}><span>0{s.number}</span><strong>{s.title[lang]}</strong><small>{s.action[lang]}</small></a></li>)}</ol>
          <div class="festival-mechanisms">{festival.mechanisms.map((m,i)=><div><span>0{i+1}</span><h3>{m.title[lang]}</h3><p>{m.text[lang]}</p></div>)}</div>
          </div><FestivalMechanismDiagram lang={lang}/></div>
          <div class="festival-rules"><h3>{t('爱情守则','Rules of Love')}</h3><ol>{festival.rules.map(rule=><li>{rule[lang]}</li>)}</ol></div>
        </section>
        <section id="experience" class="festival-chapter case-section">
          <div class="festival-section-title"><span>03 / THE FESTIVAL</span><h2>{t('六个空间，一场相亲嘉年华','Six spaces. One matchmaking festival.')}</h2></div>
          <FestivalMap links lang={lang}/><p class="festival-caption">{t('点击场景名称，跳转至对应场景。','Select a scene name to read its chapter.')}</p>
        </section>
        {scenes.map(s=><section class="festival-chapter festival-scene case-section" id={s.id}>
          <div class="festival-scene-heading"><span>SPACE / 0{s.number}</span><div><h2>{s.title[lang]}</h2>{lang==='zh'&&<p>{s.english}</p>}</div></div>
          <p class="festival-scene-summary">{s.summary[lang]}</p>
          <figure class="festival-scene-film"><video controls loop playsinline preload="none" poster={'/media/dating/scene-'+s.number+'-poster.webp'} aria-label={s.title[lang]+t('场景视频',' scene film')} data-scene-video><source src={'/media/dating/scene-'+s.number+'.mp4'} type="video/mp4"/></video><figcaption>{s.english} / {t('场景影像','SCENE FILM')}</figcaption></figure>
          <div class:list={['festival-parts',{'four-parts':s.parts.length===4}]}>{s.parts.map(part=><div><FestivalFigure image={part.image} alt={part.title[lang]} lang={lang} contained/><h3>{part.title[lang]}</h3><p>{part.text[lang]}</p></div>)}</div>
        </section>)}
        <section id="concept-film" class="festival-chapter case-section">
          <div class="festival-section-title"><span>04 / CONCEPT FILM</span><h2>{t('从空间到连续体验','From separate spaces to one journey')}</h2></div><p>{festival.film[lang]}</p>
          <div class="festival-full-film" data-full-film><img src="/media/dating/story-2.webp" alt={t('概念影片开场画面','Opening frame of the concept film')} width="640" height="360" loading="lazy"/><button type="button" data-load-film>▷ <span>{t('播放完整概念影片','PLAY THE CONCEPT FILM')}</span><small>YouTube</small></button></div>
          <a class="festival-film-link" href={festival.filmUrl} target="_blank" rel="noopener noreferrer">{t('在 YouTube 打开概念影片','Open concept film on YouTube')} ↗</a>
          <div class="festival-storyboard">{Array.from({length:12},(_,i)=><FestivalFigure image={'story-'+(i+1)} alt={t('概念影片分镜 ','Concept film frame ')+String(i+1).padStart(2,'0')} lang={lang}/>)}</div>
        </section>
        <nav class="festival-end"><a href={'/'+lang+'/works/'} data-back-link>← {t('返回作品索引','BACK TO INDEX')}</a><a href={'/'+lang+'/explore/'}>{t('继续探索星河','EXPLORE THE GALAXY')} ↗</a></nav>
      </div>
    </div>
  </div>
  </div>
</article>
<script src="../scripts/dating-festival.ts"></script>
