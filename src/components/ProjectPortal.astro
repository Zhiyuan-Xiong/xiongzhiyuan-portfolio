---
import FestivalMap from './FestivalMap.astro';
import {nexus} from '../data/nexus';
import {projects} from '../data/projects';
import {workIntros} from '../data/work-intros';
import {categories,type Lang} from '../data/site';
import '../styles/project-portal.css';
const {lang}=Astro.props as {lang:Lang};
---
<svg class="sr-only" aria-hidden="true" width="0" height="0"><defs><filter id="project-melt-filter" x="-15%" y="-20%" width="130%" height="150%"><feTurbulence type="fractalNoise" baseFrequency=".012 .038" numOctaves="1" seed="7" result="noise"/><feDisplacementMap in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" data-melt-displacement/></filter><filter id="festival-atmosphere-flow" x="-25%" y="-35%" width="150%" height="170%"><feTurbulence type="fractalNoise" baseFrequency=".008 .018" numOctaves="1" seed="13" result="flow"/><feDisplacementMap in="SourceGraphic" in2="flow" scale="105" xChannelSelector="R" yChannelSelector="G"/></filter><filter id="festival-portal-melt" x="-20%" y="-25%" width="140%" height="150%"><feTurbulence type="fractalNoise" baseFrequency=".011 .025" numOctaves="1" seed="19" result="liquid"/><feDisplacementMap in="SourceGraphic" in2="liquid" scale="0" xChannelSelector="R" yChannelSelector="G" data-portal-displacement/></filter></defs></svg>
<div class="project-portal" data-project-portal hidden aria-label={lang==='zh'?'正在展开相亲嘉年华场景':'Opening the festival spaces'} role="status"><div class="portal-stage"><div class="portal-atmosphere" aria-hidden="true"></div><div class="portal-artwork"><FestivalMap animated lang={lang}/></div><video class="portal-film" data-portal-film muted playsinline loop preload="none" poster="/media/dating/hero-poster.webp"><source data-src="/media/dating/hero.mp4" type="video/mp4"/></video></div><p class="portal-status">BLIND DATING MARKET FESTIVAL</p></div>
<div class="project-portal nexus-portal" data-nexus-portal hidden role="status" aria-label={lang==='zh'?'正在进入机械文明计划':'Entering NEXUS'}><div class="portal-stage"><video class="nexus-transition-film" data-nexus-transition muted playsinline preload="none" poster="/media/nexus/transition-poster.webp"><source data-src="/media/nexus/transition.mp4" type="video/mp4"/></video><video class="nexus-handoff-film" data-nexus-handoff muted playsinline loop preload="none" poster="/media/nexus/hero-poster.webp"><source data-src="/media/nexus/hero.mp4" type="video/mp4"/></video><div class="nexus-handoff-copy"><img src="/media/nexus/logo.webp" alt="NEXUS" width="1359" height="340"/><div><p>{nexus.title[lang]}</p><span>{lang==='zh'?nexus.subtitle.zh:'Narrative-Driven Concept Game Environment Design'}</span></div></div></div></div>
<div class="project-portal mushrooms-portal" data-mushrooms-portal hidden role="status" aria-label={lang==='zh'?'正在进入毒蘑菇世界':'Entering the mushroom world'}><div class="portal-stage"><video class="mushrooms-transition-film" data-mushrooms-transition muted playsinline preload="none" poster="/media/mushrooms/transition-poster.webp"><source data-src="/media/mushrooms/transition.mp4" type="video/mp4"/></video><video class="mushrooms-handoff-film" data-mushrooms-handoff muted playsinline loop preload="none" poster="/media/mushrooms/hero-poster.webp"><source data-src="/media/mushrooms/hero.mp4" type="video/mp4"/></video></div></div>
<div class="project-portal cosmos-portal" data-cosmos-portal hidden role="status" aria-label={lang==='zh'?'正在进入无垠的宇宙':'Entering Infinite Cosmos'}><div class="portal-stage"><video class="cosmos-transition-film" data-cosmos-transition muted playsinline preload="none" poster="/media/cosmos/transition-poster.webp"><source data-src="/media/cosmos/transition.mp4" type="video/mp4"/></video><video class="cosmos-handoff-film" data-cosmos-handoff muted playsinline loop preload="none" poster="/media/cosmos/hero-poster.webp"><source data-src="/media/cosmos/hero.mp4" type="video/mp4"/></video></div></div>
<div class="project-portal cosmos-portal" data-earthquake-portal hidden role="status" aria-label={lang==='zh'?'正在进入地震数据转译场景':'Entering the earthquake data space'}><div class="portal-stage"><video class="cosmos-transition-film" data-earthquake-transition muted playsinline preload="none" poster="/media/earthquake/transition-poster.webp"><source data-src="/media/earthquake/transition.mp4" type="video/mp4"/></video><video class="cosmos-handoff-film" data-earthquake-handoff muted playsinline loop preload="none" poster="/media/earthquake/hero-poster.webp"><source data-src="/media/earthquake/hero.mp4" type="video/mp4"/></video></div></div>
<div class="project-portal cosmos-portal" data-metamorphosis-portal hidden role="status" aria-label={lang==='zh'?'正在进入蜕变的视听空间':'Entering Metamorphosis'}><div class="portal-stage"><video class="cosmos-transition-film" data-metamorphosis-transition muted playsinline preload="none" poster="/media/metamorphosis/transition-poster.webp"><source data-src="/media/metamorphosis/transition.mp4" type="video/mp4"/></video><video class="cosmos-handoff-film" data-metamorphosis-handoff muted playsinline loop preload="none" poster="/media/metamorphosis/hero-poster.webp"><source data-src="/media/metamorphosis/hero.mp4" type="video/mp4"/></video></div></div>
<div class="project-portal skeleton-portal" data-skeleton-portal hidden role="status" aria-label={lang==='zh'?'正在生成骨骸共生首饰':'Forming the skeletal jewellery'}><div class="portal-stage"><video class="skeleton-transition-film" data-skeleton-transition muted playsinline preload="none" poster="/media/skeleton/transition-liquid-poster-v1.webp"><source data-src="/media/skeleton/transition-liquid-v1.mp4" type="video/mp4"/></video></div></div>
<dialog class="project-preview" data-project-preview aria-labelledby="project-preview-title"><canvas aria-hidden="true"></canvas><div class="project-preview-inner"><button class="project-preview-close" data-preview-close type="button"><span aria-hidden="true">×</span>{lang==='zh'?'返回作品索引':'BACK TO INDEX'}</button><a class="project-preview-image" data-preview-image-link href="#"><img data-preview-image src="/images/dating-cover-1280.webp" alt="" width="1280" height="720"/></a><div class="project-preview-copy"><div><p class="project-preview-keywords" data-preview-keywords></p><h2 id="project-preview-title" data-preview-title></h2><p class="project-preview-intro" data-preview-intro></p></div><a class="project-preview-link" data-preview-link data-case-link href="#">{lang==='zh'?'查看作品':'VIEW PROJECT'} <span aria-hidden="true">↗</span></a></div></div></dialog>
<script type="application/json" data-preview-content set:html={JSON.stringify(projects.filter(p=>p.status==='published').map(p=>({slug:p.slug,title:p.title[lang],intro:(workIntros[p.slug]??p.description)[lang],keywords:p.categories.slice(0,2).map(cat=>categories.find(x=>x.id===cat)!.label[lang]).join(' / '),cover:p.cover,alt:p.coverAlt?.[lang]})))}/>
<script src="../scripts/project-portal.ts"></script>
