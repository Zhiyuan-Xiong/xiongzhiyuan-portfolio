---
import assets from '../data/nexus-assets.json';
import type {Lang} from '../data/site';
interface Props {image:keyof typeof assets;alt:string;caption?:string;lang:Lang;contained?:boolean;blend?:boolean;eager?:boolean}
const {image,alt,caption,lang,contained=false,blend=false,eager=false}=Astro.props;
const asset=assets[image];
---
<figure class:list={['restored-figure','nexus-figure',{'is-contained':contained,'nexus-blend':blend}]}>
  <button type="button" class="image-button" data-lightbox={asset.src} data-blend={blend?'screen':undefined} data-alt={alt} data-caption={caption??''} aria-label={(lang==='zh'?'放大查看：':'Enlarge: ')+alt}>
    <img src={asset.src} width={asset.width} height={asset.height} alt={alt} loading={eager?'eager':'lazy'} decoding="async"/>
    <span class="zoom-label">{lang==='zh'?'放大查看 ↗':'ENLARGE ↗'}</span>
  </button>{caption&&<figcaption>{caption}</figcaption>}
</figure>
